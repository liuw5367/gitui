/* Graft — shared macOS-native UI system for the canvas artboards */

:root{
  --desk1:#E9EBEF;--desk2:#DADDE4;
  --content:#FFFFFF;--panel:#F7F7F9;--panel-2:#F1F1F4;--sidebar:#F4F4F6;
  --bar:#F5F5F7;--titlebar:#F0F0F2;--tabbar:#E9E9EC;--status:#F7F7F8;
  --line:#E2E2E6;--line-soft:#ECECEF;--line-strong:#D2D2D8;
  --text:#1D1D1F;--text2:#5D5D65;--text3:#6E6E76;
  --hover:rgba(0,0,0,.045);--press:rgba(0,0,0,.085);
  --sel:#E7F0FF;--sel-strong:#D5E6FF;
  --accent:#007AFF;--accent-2:#0A66E8;--primary-bg:#0A66E8;--accent-soft:#E8F1FF;
  --field:#FFFFFF;--field-border:#D2D2D8;
  --btn:#FFFFFF;--btn-border:#D2D2D8;
  --branch-bg:#E8F1FF;--branch-fg:#0B5FCC;
  --tag-bg:#FFF3DD;--tag-fg:#835700;--tag-border:#F0DEB8;
  --remote-fg:#5D5D65;
  --add-bg:#EAF7EF;--add-word:#CBEAD6;--add-fg:#1B7442;--add-ln:#E2F1E8;
  --del-bg:#FDEEEC;--del-word:#F8D0CB;--del-fg:#AE241C;--del-ln:#FBE6E3;
  --hunk-bg:#F2F6FA;--hunk-fg:#465F78;--fold-bg:#F8F8FA;
  --code-keyword:#9B2393;--code-string:#C41A16;--code-comment:#697B8C;--code-number:#1C00CF;--code-type:#0F68A0;--code-fn:#316D74;
  --avatar-bg:#DCE7F5;--avatar-fg:#2F5D8A;
  --menu-bg:#FCFCFD;--menu-line:#E5E5EA;
  --shadow-menu:0 12px 34px rgba(0,0,0,.22),0 1px 4px rgba(0,0,0,.12);
  --focus:0 0 0 3px rgba(0,122,255,.28);
  --win-border:rgba(0,0,0,.16);
  --warn:#A86400;--danger:#B3261E;--ok:#1F7A45;--purple:#7B4FD1;
  --g1:#0A84FF;--g2:#8E5AD6;--g3:#2E9E6B;--g4:#C26A00;
  --mono:"SF Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
  --sans:-apple-system,BlinkMacSystemFont,"SF Pro Text","Helvetica Neue",Helvetica,Arial,sans-serif;
}

.theme-dark{
  --desk1:#161619;--desk2:#0E0E10;
  --content:#1B1B1D;--panel:#1F1F21;--panel-2:#262628;--sidebar:#232325;
  --bar:#2A2A2C;--titlebar:#262628;--tabbar:#202022;--status:#242426;
  --line:#343438;--line-soft:#2C2C30;--line-strong:#414147;
  --text:#F2F2F4;--text2:#B3B3BB;--text3:#8E8E96;
  --hover:rgba(255,255,255,.055);--press:rgba(255,255,255,.09);
  --sel:#15324F;--sel-strong:#1B3D60;
  --accent:#0A84FF;--accent-2:#409CFF;--primary-bg:#0A66E8;--accent-soft:#15324F;
  --field:#232326;--field-border:#3C3C42;
  --btn:#2C2C2F;--btn-border:#414147;
  --branch-bg:#15324F;--branch-fg:#8CC2FF;
  --tag-bg:#3A2E16;--tag-fg:#F0C674;--tag-border:#514020;
  --remote-fg:#A9A9B1;
  --add-bg:rgba(46,160,90,.17);--add-word:rgba(84,200,130,.28);--add-fg:#7EE2A8;--add-ln:rgba(46,160,90,.10);
  --del-bg:rgba(214,72,60,.15);--del-word:rgba(235,100,90,.26);--del-fg:#FF9B93;--del-ln:rgba(214,72,60,.09);
  --hunk-bg:#1E2833;--hunk-fg:#A8C0D8;--fold-bg:#202024;
  --code-keyword:#FC5FA3;--code-string:#FC6A5D;--code-comment:#7F8C98;--code-number:#D0BF69;--code-type:#5DD8FF;--code-fn:#67B7A4;
  --avatar-bg:#2C3D52;--avatar-fg:#BBD2EC;
  --menu-bg:#2C2C2E;--menu-line:#3D3D42;
  --shadow-menu:0 14px 40px rgba(0,0,0,.55),0 1px 4px rgba(0,0,0,.4);
  --win-border:rgba(255,255,255,.14);
  --warn:#E8B04A;--danger:#FF8A80;--ok:#6FD39A;--purple:#BFA0FF;
  --g1:#4CA3FF;--g2:#C084FC;--g3:#4ADE9A;--g4:#F0B44A;
}

*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;font-family:var(--sans);font-size:13px;line-height:1.4;color:var(--text);background:var(--desk1);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
button{font:inherit;color:inherit;background:none;border:0;padding:0;margin:0;cursor:default}
input,textarea{font:inherit;color:inherit}
a{color:var(--accent-2);text-decoration:none}
svg{display:block}
::selection{background:rgba(0,122,255,.22)}
.desktop{color-scheme:light;height:100vh;min-height:600px;display:flex;align-items:center;justify-content:center;padding:24px;background:linear-gradient(180deg,var(--desk1) 0%,var(--desk2) 100%)}
.theme-dark.desktop{color-scheme:dark}
.window{width:100%;height:calc(100vh - 48px);min-height:560px;display:flex;flex-direction:column;background:var(--content);border:1px solid var(--win-border);border-radius:12px;overflow:hidden;box-shadow:0 30px 80px rgba(16,24,40,.26),0 5px 16px rgba(16,24,40,.12);animation:win-in .3s cubic-bezier(.2,.8,.25,1)}
@keyframes win-in{from{opacity:0;transform:translateY(6px) scale(.997)}to{opacity:1;transform:none}}

/* ---------- title bar ---------- */
.titlebar{height:38px;flex:none;display:flex;align-items:center;gap:8px;padding:0 13px;background:var(--titlebar);border-bottom:1px solid var(--line);position:relative;z-index:5}
.lights{display:flex;gap:8px;flex:none}
.light{width:12px;height:12px;border-radius:50%;box-shadow:inset 0 0 0 .5px rgba(0,0,0,.14)}
.light.red{background:#FF5F57}.light.yellow{background:#FEBC2E}.light.green{background:#28C840}
.win-title{position:absolute;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600;color:var(--text);white-space:nowrap}
.win-title .branch{font-weight:400;color:var(--text3);font-size:11.5px}
.title-right{margin-left:auto;display:flex;align-items:center;gap:4px;color:var(--text3);font-size:11px}
.tb-icon{width:26px;height:24px;display:flex;align-items:center;justify-content:center;border-radius:6px;color:var(--text2)}
.tb-icon:hover{background:var(--hover)}
.tb-icon:active{background:var(--press)}

/* ---------- toolbar ---------- */
.toolbar{height:46px;flex:none;display:flex;align-items:center;gap:6px;padding:0 12px;background:var(--bar);border-bottom:1px solid var(--line);position:relative;z-index:4}
.tbtn{height:27px;padding:0 9px;display:inline-flex;align-items:center;gap:5px;border-radius:6px;font-size:12px;font-weight:500;color:var(--text);white-space:nowrap;transition:background-color .13s ease}
.tbtn:hover{background:var(--hover)}
.tbtn:active{background:var(--press)}
.tbtn.muted{color:var(--text2);font-weight:400}
.tbtn.ai{background:var(--accent-soft);color:var(--accent-2);font-weight:600}
.tbtn.ai:hover{background:var(--sel-strong)}
.tbtn .ico{color:var(--text2)}
.tb-sep{width:1px;height:18px;background:var(--line-strong);margin:0 3px;flex:none}
.tool-spacer{flex:1}
.search{width:176px;height:26px;display:flex;align-items:center;gap:6px;padding:0 7px 0 8px;background:var(--field);border:1px solid var(--field-border);border-radius:6px;color:var(--text3);transition:border-color .15s ease,box-shadow .15s ease}
.search input{flex:1;min-width:0;border:0;outline:0;background:transparent;font-size:12px;color:var(--text)}
.search input::placeholder{color:var(--text3)}
.search:focus-within{border-color:var(--accent);box-shadow:var(--focus)}
.kbd{font-family:var(--sans);font-size:10px;color:var(--text3);border:1px solid var(--line);border-radius:4px;padding:0 4px;line-height:15px;background:var(--panel)}
.seg{display:flex;align-items:center;gap:2px;padding:2px;background:var(--panel-2);border:1px solid var(--line-soft);border-radius:7px;flex:none}
.seg button,.seg a,.seg span{height:22px;padding:0 10px;display:flex;align-items:center;gap:5px;border-radius:5px;font-size:11.5px;font-weight:500;color:var(--text2);white-space:nowrap;text-decoration:none}
.seg .on{background:var(--content);color:var(--text);box-shadow:0 1px 2px rgba(0,0,0,.13),0 0 0 .5px rgba(0,0,0,.05)}
.seg.tiny button,.seg.tiny a,.seg.tiny span{height:20px;padding:0 7px;font-size:10.5px}
.seg .count{font-size:10px;color:var(--text3);font-variant-numeric:tabular-nums}
.seg .on .count{color:var(--accent-2)}

/* ---------- repo tabs ---------- */
.tabbar{height:34px;flex:none;display:flex;align-items:flex-end;gap:1px;padding:0 10px;background:var(--tabbar);border-bottom:1px solid var(--line);position:relative;z-index:3;overflow:hidden}
.title-tabs{display:flex;align-items:center;gap:4px;min-width:0;margin-left:8px;overflow:hidden}
.rtab{height:27px;display:flex;align-items:center;gap:7px;padding:0 9px 0 10px;min-width:0;max-width:178px;background:transparent;border:1px solid transparent;border-radius:6px;font-size:11.5px;color:var(--text2);white-space:nowrap;text-align:left;transition:background-color .12s ease}
.rtab:hover{background:var(--hover)}
.rtab.active{height:27px;background:var(--content);color:var(--text);font-weight:500;border-color:var(--line-strong);box-shadow:0 1px 2px rgba(0,0,0,.10)}
.rtab .rn{overflow:hidden;text-overflow:ellipsis}
.rtab .rdot{width:5px;height:5px;border-radius:50%;background:var(--accent);flex:none}
.rtab .x{width:14px;height:14px;margin-left:auto;display:flex;align-items:center;justify-content:center;border-radius:3px;color:var(--text3);opacity:0}
.rtab:hover .x{opacity:1}
.rtab .x:hover{background:var(--hover);color:var(--text)}
.tabadd{height:27px;width:27px;margin:0 0 0 2px;display:flex;align-items:center;justify-content:center;border-radius:6px;color:var(--text2)}
.tabadd:hover{background:var(--hover)}
.tabbar .tabs-end{margin-left:auto;display:flex;align-items:center;gap:5px;padding-bottom:5px;color:var(--text3);font-size:10.5px}

/* ---------- panels ---------- */
.body{flex:1;display:flex;min-height:0}
.sidebar{width:232px;flex:none;display:flex;flex-direction:column;background:var(--sidebar);border-right:1px solid var(--line);min-height:0;overflow:hidden}
.side-scroll{flex:1;overflow:auto;padding:2px 8px 12px}
.side-head{display:flex;align-items:center;gap:5px;height:27px;padding:0 6px;margin-top:8px;font-size:10.5px;font-weight:600;letter-spacing:.035em;text-transform:uppercase;color:var(--text3)}
.side-head .chev{opacity:.75}
.side-head .count{margin-left:auto;font-weight:500;letter-spacing:0;font-size:10.5px;text-transform:none;color:var(--text3)}
.side-row{width:100%;display:flex;align-items:center;gap:7px;height:26px;padding:0 7px;border-radius:6px;font-size:12.5px;color:var(--text);white-space:nowrap;overflow:hidden;text-align:left;transition:background-color .12s ease}
.side-row:hover{background:var(--hover)}
.side-row.sel{background:var(--sel);font-weight:500}
.side-row .nm{overflow:hidden;text-overflow:ellipsis}
.side-row .count{margin-left:auto;font-size:10.5px;color:var(--text3);font-variant-numeric:tabular-nums}
.side-row .dot{width:6px;height:6px;border-radius:50%;flex:none}
.side-row .di{width:15px;height:15px;flex:none;display:flex;align-items:center;justify-content:center;color:var(--text3)}
.side-row.sel .di{color:var(--accent)}
.side-row.ind1{padding-left:20px;font-size:12px;color:var(--text2)}
.side-row.ind2{padding-left:32px;font-size:11.5px;color:var(--text2)}
.side-row .up{font-size:10px;color:var(--ok);font-variant-numeric:tabular-nums}
.side-row .down{font-size:10px;color:var(--warn);font-variant-numeric:tabular-nums}
.side-row .tag-dot{width:7px;height:7px;border-radius:2px;background:var(--warn);opacity:.65;flex:none}
.side-empty{padding:5px 8px 2px;font-size:11px;color:var(--text3)}
.side-stash .st{display:block;font-size:11px;color:var(--text3);margin-top:-1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

.main{flex:1;min-width:0;display:flex;flex-direction:column;background:var(--content);position:relative}
.insp{width:360px;flex:none;min-height:0;display:flex;flex-direction:column;background:var(--panel);border-left:1px solid var(--line)}
.insp.wide{width:400px}

.statusbar{height:24px;flex:none;display:flex;align-items:center;gap:9px;padding:0 12px;border-top:1px solid var(--line);background:var(--status);font-size:10.5px;color:var(--text3);white-space:nowrap;overflow:hidden}
.statusbar .sitem{display:flex;align-items:center;gap:4px}
.statusbar .spacer{flex:1}
.statusbar .ok{color:var(--ok)}
.statusbar .warn{color:var(--warn)}

/* ---------- history ---------- */
.hist{flex:none;display:flex;flex-direction:column;background:var(--content);overflow:hidden;position:relative}
.hist-bar{height:32px;flex:none;display:flex;align-items:center;gap:7px;padding:0 10px;border-bottom:1px solid var(--line-soft);background:var(--content)}
.hist-title{font-size:11.5px;font-weight:600;color:var(--text)}
.hist-count{font-size:10.5px;color:var(--text3);font-variant-numeric:tabular-nums}
.hist-bar .spacer{flex:1}
.chipbtn{height:21px;padding:0 7px;display:inline-flex;align-items:center;gap:4px;border:1px solid var(--line);background:var(--panel);border-radius:5px;font-size:10.5px;color:var(--text2);white-space:nowrap}
.chipbtn:hover{background:var(--hover)}
.commit-cols{height:23px;flex:none;display:grid;grid-template-columns:64px minmax(0,1fr) 96px 58px;align-items:center;padding:0 8px;border-bottom:1px solid var(--line-soft);font-size:9.5px;font-weight:600;letter-spacing:.035em;text-transform:uppercase;color:var(--text3);background:var(--content)}
.commit-cols .cd{text-align:right}
.commit{width:100%;height:38px;flex:none;display:grid;grid-template-columns:64px minmax(0,1fr) 96px 58px;align-items:center;padding:0 8px;border-bottom:1px solid var(--line-soft);text-align:left;transition:background-color .12s ease;position:relative}
.commit:hover{background:var(--hover)}
.commit.sel{background:var(--sel)}
.commit.sel::before{content:"";position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--accent)}
.cg{position:relative;height:38px;align-self:center}
.cg svg{position:absolute;inset:0}
.cm{min-width:0;display:flex;align-items:center;gap:7px;padding-right:6px}
.cm .msg{font-size:12px;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.commit.sel .cm .msg{font-weight:500}
.cm .refs{display:flex;gap:4px;flex:none;max-width:190px;overflow:hidden}
.ref{height:16px;padding:0 5px;display:inline-flex;align-items:center;gap:3px;border-radius:4px;font-size:9.5px;font-weight:600;white-space:nowrap;line-height:16px}
.ref.branch{background:var(--branch-bg);color:var(--branch-fg)}
.ref.tag{background:var(--tag-bg);color:var(--tag-fg);box-shadow:inset 0 0 0 1px var(--tag-border)}
.ref.remote{background:transparent;color:var(--remote-fg);box-shadow:inset 0 0 0 1px var(--line-strong);font-weight:500}
.commit.sel .ref.branch{background:rgba(255,255,255,.72);box-shadow:inset 0 0 0 1px rgba(11,95,204,.22)}
.commit.sel .ref.tag{background:rgba(255,255,255,.78)}
.theme-dark .commit.sel .ref.branch{background:rgba(255,255,255,.12);box-shadow:inset 0 0 0 1px rgba(140,194,255,.3)}
.theme-dark .commit.sel .ref.tag{background:rgba(255,255,255,.10)}
.ref .rd{width:4px;height:4px;border-radius:50%;background:currentColor}
.ca{font-size:11px;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-right:6px}
.cd{font-size:10.5px;color:var(--text3);text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
.splitter{height:6px;flex:none;background:var(--panel-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line);position:relative;z-index:2}
.splitter::after{content:"";position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:26px;height:2px;border-radius:2px;background:var(--line-strong);opacity:.5}
.splitter:hover::after{opacity:1;background:var(--accent)}

/* ---------- inspector ---------- */
.insp-head{padding:12px 14px 10px;border-bottom:1px solid var(--line);background:var(--panel);flex:none}
.commit-title{font-size:13px;font-weight:600;line-height:1.32;letter-spacing:-.005em;color:var(--text);margin:0}
.meta{display:flex;align-items:center;gap:7px;margin-top:9px;min-width:0}
.avatar{width:21px;height:21px;border-radius:50%;background:var(--avatar-bg);color:var(--avatar-fg);display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;flex:none;letter-spacing:.02em}
.avatar.lg{width:26px;height:26px;font-size:10px}
.meta .who{display:flex;flex-direction:column;min-width:0;line-height:1.2}
.meta .who b{font-size:11.5px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.meta .who span{font-size:10px;color:var(--text3);margin-top:1px}
.hashrow{display:flex;align-items:center;gap:6px;margin-top:9px;font-size:10.5px;color:var(--text3);min-width:0}
.hash{font-family:var(--mono);font-size:10.5px;color:var(--text2);background:var(--panel-2);border:1px solid var(--line-soft);padding:2px 5px;border-radius:4px;display:inline-flex;align-items:center;gap:4px;white-space:nowrap}
.hash .copy{color:var(--text3);display:flex}
.insp-tabs{height:33px;flex:none;display:flex;align-items:stretch;gap:14px;padding:0 14px;border-bottom:1px solid var(--line);background:var(--panel)}
.itab{height:33px;display:flex;align-items:center;gap:5px;font-size:11.5px;color:var(--text2);border-bottom:2px solid transparent;margin-bottom:-1px;white-space:nowrap}
.itab.on{color:var(--text);font-weight:600;border-color:var(--accent)}
.itab .n{font-size:9.5px;color:var(--text3);background:var(--panel-2);border-radius:4px;padding:0 4px;line-height:14px;font-weight:600}
.itab.on .n{color:var(--accent-2);background:var(--accent-soft)}
.insp-body{flex:1;min-height:0;overflow:auto;padding:10px 10px 12px}
.statline{display:flex;align-items:center;gap:8px;padding:1px 4px 8px;font-size:10.5px;color:var(--text3);border-bottom:1px solid var(--line-soft);margin-bottom:8px}
.statline b{color:var(--text2);font-weight:600}
.plus{color:var(--add-fg);font-variant-numeric:tabular-nums}
.minus{color:var(--del-fg);font-variant-numeric:tabular-nums}
.fgroup{display:flex;align-items:center;gap:6px;height:23px;padding:0 7px;margin-top:3px;font-size:10.5px;font-weight:600;color:var(--text3);letter-spacing:.01em}
.fgroup .chev{opacity:.6}
.file-row{width:100%;display:flex;align-items:center;gap:6px;height:27px;padding:0 7px;border-radius:5px;font-size:11.5px;color:var(--text);white-space:nowrap;overflow:hidden;text-align:left;transition:background-color .12s ease}
.file-row:hover{background:var(--hover)}
.file-row.on{background:var(--sel)}
.file-row .fi{color:var(--text3);flex:none;width:14px}
.file-row.on .fi{color:var(--accent)}
.file-row .fn{min-width:0;overflow:hidden;text-overflow:ellipsis;font-family:var(--mono);font-size:10.5px}
.file-row .st{width:11px;font-family:var(--mono);font-size:9.5px;font-weight:700;flex:none;text-align:center}
.st.m{color:var(--warn)}.st.a{color:var(--ok)}.st.d{color:var(--danger)}.st.r{color:var(--purple)}
.file-row .nums{margin-left:auto;display:flex;gap:4px;font-family:var(--mono);font-size:9.5px;flex:none}
.insp-sect{margin-top:13px;border-top:1px solid var(--line-soft);padding-top:9px}
.sect-label{font-size:9.5px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--text3);padding:0 4px;margin-bottom:5px}
.kv{display:flex;justify-content:space-between;gap:10px;padding:2px 4px;font-size:10.5px;color:var(--text2)}
.kv b{font-weight:500;color:var(--text);text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.insp-foot{flex:none;display:flex;align-items:center;gap:7px;padding:8px 12px;border-top:1px solid var(--line);background:var(--panel)}
.insp-foot .spacer{flex:1}

/* ---------- buttons / fields ---------- */
.btn{height:27px;padding:0 10px;display:inline-flex;align-items:center;justify-content:center;gap:5px;border-radius:6px;border:1px solid var(--btn-border);background:var(--btn);color:var(--text);font-size:11.5px;font-weight:500;box-shadow:0 1px 0 rgba(0,0,0,.03);white-space:nowrap;transition:background-color .13s ease,box-shadow .13s ease}
.btn:hover{background:var(--panel-2)}
.btn:active{background:var(--panel-2);box-shadow:none}
.btn:focus-visible{outline:none;box-shadow:var(--focus)}
.btn.primary{background:var(--primary-bg);border-color:transparent;color:#fff;box-shadow:0 1px 2px rgba(0,0,0,.18),inset 0 1px 0 rgba(255,255,255,.18)}
.btn.primary:hover{background:var(--primary-bg);filter:brightness(.95)}
.btn.primary:active{background:var(--primary-bg);filter:brightness(.96)}
.btn.small{height:23px;padding:0 8px;font-size:10.5px;border-radius:5px}
.btn.ghost{border-color:transparent;background:transparent;box-shadow:none;color:var(--text2)}
.btn.ghost:hover{background:var(--hover);color:var(--text)}
.btn.wide{width:100%}
.btn .ico{color:currentColor;opacity:.9}
.btn.primary .ico{opacity:1}
.btn.split{border-radius:6px 0 0 6px;border-right:0}
.btn.split-r{width:24px;border-radius:0 6px 6px 0;padding:0}
.field{height:27px;display:flex;align-items:center;gap:6px;padding:0 8px;background:var(--field);border:1px solid var(--field-border);border-radius:6px;color:var(--text3);box-shadow:inset 0 1px 1px rgba(0,0,0,.025)}
.field input{flex:1;min-width:0;border:0;outline:0;background:transparent;font-size:12px;color:var(--text)}
.field input::placeholder{color:var(--text3)}
.field:focus-within{border-color:var(--accent);box-shadow:var(--focus)}
.label{font-size:10.5px;font-weight:600;color:var(--text2);letter-spacing:.01em}
.hint{font-size:10px;color:var(--text3)}
.checkrow{display:flex;align-items:center;gap:7px;height:22px;font-size:11.5px;color:var(--text2)}
input[type=checkbox]{width:13px;height:13px;margin:0;accent-color:var(--accent);flex:none;border-radius:3px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}

/* ---------- diff ---------- */
.diffpane{flex:1;min-height:0;display:flex;flex-direction:column;background:var(--content)}
.diffbar{height:38px;flex:none;display:flex;align-items:center;gap:8px;padding:0 11px;border-bottom:1px solid var(--line);background:var(--content)}
.crumb{display:flex;align-items:center;gap:6px;min-width:0;font-size:11px;color:var(--text2);white-space:nowrap}
.crumb .chev{color:var(--text3);flex:none}
.crumb .hash{flex:none}
.crumb .fp{font-family:var(--mono);font-size:11px;color:var(--text);overflow:hidden;text-overflow:ellipsis}
.crumb .stat{font-family:var(--mono);font-size:9.5px;color:var(--text3);flex:none}
.diffbar .spacer{flex:1}
.iconbtn{width:24px;height:24px;display:inline-flex;align-items:center;justify-content:center;border-radius:5px;color:var(--text2)}
.iconbtn:hover{background:var(--hover)}
.iconbtn.on{background:var(--sel);color:var(--accent)}
.diffbody{flex:1;min-height:0;overflow:auto;background:var(--content);font-family:var(--mono);font-size:11px;line-height:19px;color:var(--text)}
.dtable{width:100%;border-collapse:collapse;table-layout:fixed}
.dtable td{padding:0;vertical-align:top}
.dtable .ln{width:42px;text-align:right;padding:0 7px 0 4px;color:var(--text3);font-size:9.5px;user-select:none;border-right:1px solid var(--line-soft);background:var(--content)}
.dtable .code{padding:0 10px;white-space:pre;overflow:hidden;color:var(--text)}
.dtable .code .pad{display:block;min-width:100%}
.dtable tr.ctx .ln{color:var(--text3)}
.dtable tr.add td{background:var(--add-bg)}
.dtable tr.add .ln{background:var(--add-ln);color:var(--add-fg)}
.dtable tr.del td{background:var(--del-bg)}
.dtable tr.del .ln{background:var(--del-ln);color:var(--del-fg)}
.dtable td.empty{background:var(--panel-2);opacity:.55}
.dtable tr.hunk td{background:var(--hunk-bg);border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft)}
.dtable .hunkline{height:21px;display:flex;align-items:center;gap:8px;padding:0 8px;color:var(--hunk-fg);font-size:10px;white-space:nowrap}
.dtable .hunkline .ha{margin-left:auto;display:flex;gap:4px;align-items:center}
.dtable .hunkline .mini{height:17px;padding:0 5px;display:inline-flex;align-items:center;gap:3px;border:1px solid var(--line);background:var(--content);border-radius:4px;font-family:var(--sans);font-size:9.5px;color:var(--text2)}
.dtable tr.fold td{background:var(--fold-bg);border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft)}
.dtable .foldline{height:20px;display:flex;align-items:center;justify-content:center;gap:6px;color:var(--text3);font-family:var(--sans);font-size:10px}
.dhead{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--line);background:var(--panel-2);font-family:var(--mono);font-size:9.5px;color:var(--text3)}
.dhead .dh{padding:4px 9px;display:flex;align-items:center;gap:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dhead .dh:first-child{border-right:1px solid var(--line)}
.dhead .dh b{font-weight:600;color:var(--text2)}
.word-add{background:var(--add-word);border-radius:2px}
.word-del{background:var(--del-word);border-radius:2px}
.difftable-wrap{min-width:0}
.diffbody.split .dtable td.code{font-size:10.5px}
.k{color:var(--code-keyword)}.s{color:var(--code-string)}.c{color:var(--code-comment);font-style:italic}.n{color:var(--code-number)}.t{color:var(--code-type)}.f{color:var(--code-fn)}

/* ---------- working tree / commit ---------- */
.changeslist{flex:none;display:flex;flex-direction:column;background:var(--content);overflow:hidden;position:relative}
.changes-bar{height:32px;flex:none;display:flex;align-items:center;gap:8px;padding:0 10px;border-bottom:1px solid var(--line-soft)}
.changes-bar .spacer{flex:1}
.changes-cols{height:23px;flex:none;display:grid;grid-template-columns:24px minmax(0,1fr) 54px 64px;align-items:center;padding:0 8px;border-bottom:1px solid var(--line-soft);font-size:9.5px;font-weight:600;letter-spacing:.035em;text-transform:uppercase;color:var(--text3)}
.changes-cols .r{text-align:right}
.change-row{height:32px;flex:none;display:grid;grid-template-columns:24px minmax(0,1fr) 54px 64px;align-items:center;padding:0 8px;border-bottom:1px solid var(--line-soft);transition:background-color .12s ease}
.nmbtn{display:flex;align-items:center;gap:6px;min-width:0;width:100%;height:100%;text-align:left;font:inherit;color:inherit;background:none}
.nmbtn:focus-visible{outline:none;box-shadow:var(--focus);border-radius:4px}
.change-row:hover{background:var(--hover)}
.change-row.on{background:var(--sel)}
.change-row .ck{display:flex;align-items:center}
.change-row .nm{min-width:0;display:flex;align-items:center;gap:6px;font-family:var(--mono);font-size:10.5px;white-space:nowrap;overflow:hidden}
.change-row .nm .dir{color:var(--text3)}
.change-row .nm .base{color:var(--text);overflow:hidden;text-overflow:ellipsis}
.change-row .stat{font-family:var(--mono);font-size:9.5px;text-align:right;white-space:nowrap}
.change-row .sst{font-family:var(--mono);font-size:9.5px;text-align:right;color:var(--text3);white-space:nowrap}
.grouplabel{height:22px;display:flex;align-items:center;gap:5px;padding:0 8px;font-size:9.5px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--text3);background:var(--panel)}
.grouplabel .n{margin-left:auto;font-weight:500;letter-spacing:0;color:var(--text3)}

.form{display:flex;flex-direction:column;gap:9px;padding:12px}
.form .frow{display:flex;flex-direction:column;gap:4px}
.textarea{width:100%;min-height:64px;resize:none;padding:6px 8px;border:1px solid var(--field-border);border-radius:6px;background:var(--field);color:var(--text);font-size:11.5px;line-height:1.45;outline:0}
.textarea:focus{border-color:var(--accent);box-shadow:var(--focus)}
.form .meta-line{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:10px;color:var(--text3)}
.staged-box{border:1px solid var(--line);border-radius:7px;background:var(--content);overflow:hidden}
.staged-head{height:26px;display:flex;align-items:center;gap:6px;padding:0 8px;font-size:10px;font-weight:600;color:var(--text2);background:var(--panel-2);border-bottom:1px solid var(--line-soft)}
.staged-head .n{margin-left:auto;font-weight:500;color:var(--text3);font-variant-numeric:tabular-nums}
.staged-file{height:24px;display:flex;align-items:center;gap:6px;padding:0 8px;font-family:var(--mono);font-size:9.5px;color:var(--text2);border-bottom:1px solid var(--line-soft)}
.staged-file:last-child{border-bottom:0}
.staged-file .st{margin-left:auto;font-size:9px}
.form-actions{display:flex;gap:6px;margin-top:2px}
.form-actions .btn.primary{flex:1}
.agent-nudge{display:flex;align-items:center;gap:7px;padding:7px 8px;border:1px solid var(--line);border-radius:7px;background:var(--content);font-size:10.5px;color:var(--text2)}
.agent-nudge .sp{color:var(--accent);flex:none}
.agent-nudge .go{margin-left:auto;color:var(--accent-2);font-weight:500;white-space:nowrap}

/* ---------- files at commit ---------- */
.filebar{height:38px;flex:none;display:flex;align-items:center;gap:8px;padding:0 11px;border-bottom:1px solid var(--line);background:var(--content)}
.filebar .spacer{flex:1}
.fileview{flex:1;min-height:0;overflow:auto;background:var(--content)}
.codetable{width:100%;border-collapse:collapse;table-layout:fixed;font-family:var(--mono);font-size:11px;line-height:19px}
.codetable td{padding:0;vertical-align:top}
.codetable .ln{width:46px;text-align:right;padding:0 9px 0 4px;color:var(--text3);font-size:9.5px;user-select:none;border-right:1px solid var(--line-soft)}
.codetable .code{padding:0 14px;white-space:pre;overflow:hidden;color:var(--text)}
.codetable tr:hover td{background:var(--hover)}
.badge-soft{display:inline-flex;align-items:center;gap:4px;height:18px;padding:0 6px;border-radius:4px;background:var(--panel-2);border:1px solid var(--line-soft);font-size:9.5px;color:var(--text3);white-space:nowrap}
.filepathbar{display:flex;align-items:center;gap:5px;font-size:10.5px;color:var(--text2);min-width:0;white-space:nowrap}
.filepathbar .fp{font-family:var(--mono);font-size:11px;color:var(--text)}
.filepathbar .sep{color:var(--text3)}

/* ---------- agent ---------- */
.agent-head{flex:none;padding:10px 12px;border-bottom:1px solid var(--line);background:var(--panel);display:flex;align-items:center;gap:8px}
.agent-id{display:flex;align-items:center;gap:7px;min-width:0}
.agent-ic{width:24px;height:24px;border-radius:7px;background:var(--text);color:var(--content);display:flex;align-items:center;justify-content:center;flex:none}
.agent-name{font-size:12px;font-weight:600;color:var(--text);line-height:1.2}
.agent-sub{font-size:9.5px;color:var(--text3);display:flex;align-items:center;gap:3px}
.agent-head .spacer{flex:1}
.agent-scroll{flex:1;min-height:0;overflow:auto;padding:12px;display:flex;flex-direction:column;gap:10px;background:var(--content)}
.msg-user{align-self:flex-end;max-width:88%;background:var(--primary-bg);color:#fff;border-radius:11px 11px 3px 11px;padding:7px 10px;font-size:11.5px;line-height:1.4}
.msg-agent{display:flex;gap:8px;align-items:flex-start}
.msg-agent .agent-ic{width:20px;height:20px;border-radius:6px;margin-top:1px}
.msg-agent .bubble{font-size:11.5px;line-height:1.45;color:var(--text);min-width:0}
.msg-agent .bubble b{font-weight:600}
.toolcard{border:1px solid var(--line);border-radius:8px;background:var(--panel);overflow:hidden;font-size:10px}
.tool-head{height:27px;display:flex;align-items:center;gap:6px;padding:0 8px;border-bottom:1px solid var(--line-soft);color:var(--text2);font-weight:500}
.tool-head .cmd{font-family:var(--mono);font-size:9.5px;color:var(--text)}
.tool-head .ok{margin-left:auto;color:var(--ok);font-size:9px}
.tool-body{padding:5px 9px 7px;font-family:var(--mono);font-size:9.5px;color:var(--text2);line-height:1.55}
.plan{border:1px solid var(--line);border-radius:9px;background:var(--panel);overflow:hidden}
.plan-head{height:29px;display:flex;align-items:center;gap:6px;padding:0 9px;border-bottom:1px solid var(--line-soft);font-size:10.5px;font-weight:600;color:var(--text2)}
.plan-head .tagx{margin-left:auto;font-size:8.5px;font-weight:600;color:var(--warn);background:var(--tag-bg);border-radius:4px;padding:1px 4px;letter-spacing:.02em}
.plan-step{display:flex;align-items:flex-start;gap:7px;padding:5px 9px;font-size:10.5px;color:var(--text2);line-height:1.35}
.plan-step .num{width:14px;height:14px;border-radius:50%;border:1px solid var(--line-strong);display:flex;align-items:center;justify-content:center;font-size:8px;color:var(--text3);flex:none;margin-top:1px}
.plan-step.done .num{background:var(--ok);border-color:transparent;color:#fff}
.plan-step .tx{min-width:0}
.plan-step .tx code{font-family:var(--mono);font-size:9.5px;background:var(--panel-2);border-radius:3px;padding:0 3px;color:var(--text)}
.plan-foot{padding:7px 9px;border-top:1px solid var(--line-soft);display:flex;align-items:center;gap:5px}
.plan-foot .note{font-size:9px;color:var(--text3);margin-right:auto}
.agent-foot{flex:none;border-top:1px solid var(--line);background:var(--panel);padding:9px 10px}
.composer{border:1px solid var(--field-border);border-radius:8px;background:var(--field);padding:7px 8px 6px}
.composer:focus-within{border-color:var(--accent);box-shadow:var(--focus)}
.composer textarea{width:100%;border:0;outline:0;resize:none;background:transparent;color:var(--text);font-size:11.5px;line-height:1.4;min-height:30px}
.composer textarea::placeholder{color:var(--text3)}
.composer-bar{display:flex;align-items:center;gap:5px;margin-top:3px;color:var(--text3)}
.composer-bar .spacer{flex:1}
.send-btn{width:23px;height:23px;border-radius:6px;background:var(--primary-bg);color:#fff;display:flex;align-items:center;justify-content:center}
.agent-scope{display:flex;align-items:center;gap:4px;margin-top:6px;font-size:9px;color:var(--text3)}
.agent-scope .lock{color:var(--text3)}

/* ---------- context menu ---------- */
.menu{position:absolute;z-index:30;width:252px;padding:5px;background:var(--menu-bg);border:1px solid var(--menu-line);border-radius:9px;box-shadow:var(--shadow-menu);backdrop-filter:blur(26px);-webkit-backdrop-filter:blur(26px)}
.mi{width:100%;height:24px;display:flex;align-items:center;gap:6px;padding:0 8px;border-radius:5px;font-size:12px;color:var(--text);white-space:nowrap;text-align:left}
.mi:hover{background:var(--primary-bg);color:#fff}
.mi .sc{margin-left:auto;font-size:10px;color:var(--text3);letter-spacing:.02em}
.mi:hover .sc{color:rgba(255,255,255,.78)}
.mi.disabled{color:var(--text3);opacity:.55}
.mi .chev{margin-left:auto;color:var(--text3)}
.msep{height:1px;background:var(--menu-line);margin:5px 7px}
.mlabel{padding:4px 8px 3px;font-size:9px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--text3)}

/* ---------- welcome ---------- */
.welcome .window{width:min(1180px,100%);height:min(760px,calc(100vh - 48px));min-height:560px}
.wbody{flex:1;display:flex;min-height:0}
.wside{width:312px;flex:none;display:flex;flex-direction:column;background:var(--sidebar);border-right:1px solid var(--line);min-height:0}
.wside-top{padding:16px 16px 10px}
.wside-title{font-size:17px;font-weight:700;letter-spacing:-.015em;color:var(--text)}
.wside-sub{font-size:10.5px;color:var(--text3);margin-top:2px}
.wsearch{margin:2px 12px 8px;height:27px}
.wgroup{padding:0 6px;margin-top:8px}
.wglabel{display:flex;align-items:center;gap:5px;height:23px;padding:0 8px;font-size:9.5px;font-weight:600;letter-spacing:.045em;text-transform:uppercase;color:var(--text3)}
.wrepo{width:100%;display:flex;align-items:center;gap:9px;height:47px;padding:0 8px;border-radius:7px;text-align:left;font:inherit;transition:background-color .12s ease}
.wrepo:hover{background:var(--hover)}
.wrepo.on{background:var(--sel)}
.wrepo .wico{width:27px;height:27px;border-radius:7px;background:var(--panel);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;color:var(--text2);flex:none}
.wrepo.on .wico{background:var(--content);color:var(--accent);border-color:var(--line-strong)}
.wrepo .wi{min-width:0;flex:1}
.wrepo .wn{font-size:12px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.wrepo .wp{font-family:var(--mono);font-size:9.5px;color:var(--text3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}
.wrepo .wt{font-size:9px;color:var(--text3);white-space:nowrap;flex:none}
.wfoot{flex:none;margin-top:auto;padding:10px 14px;border-top:1px solid var(--line);display:flex;align-items:center;gap:6px;font-size:9.5px;color:var(--text3)}
.wfoot .spacer{flex:1}
.wmain{flex:1;min-width:0;overflow:auto;padding:44px 54px 30px;background:var(--content);position:relative}
.watermark{position:absolute;right:28px;bottom:16px;opacity:.07;pointer-events:none;color:var(--text)}
.hero{display:flex;align-items:center;gap:16px}
.appmark{width:64px;height:64px;border-radius:15px;background:var(--accent-2);display:flex;align-items:center;justify-content:center;box-shadow:inset 0 1px 0 rgba(255,255,255,.28),0 7px 18px rgba(10,102,232,.28);flex:none}
.hero .ht{min-width:0}
.wtitle{font-size:31px;font-weight:700;letter-spacing:-.028em;line-height:1.05;color:var(--text);margin:0}
.wsub2{font-size:12.5px;color:var(--text2);margin-top:7px;line-height:1.4}
.wactions{display:flex;align-items:center;gap:8px;margin-top:25px}
.wactions .btn{height:31px;padding:0 13px;font-size:12px}
.wsection{margin-top:31px;padding-top:21px;border-top:1px solid var(--line);max-width:600px}
.wsection-title{font-size:13px;font-weight:600;color:var(--text);letter-spacing:-.01em}
.wsection-sub{font-size:10.5px;color:var(--text3);margin-top:3px}
.clone-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:13px}
.clone-grid .full{grid-column:1 / -1}
.clone-actions{display:flex;align-items:center;gap:8px;margin-top:10px}
.protocol{display:inline-flex;align-items:center;gap:2px;padding:2px;background:var(--panel-2);border-radius:5px;font-size:9.5px;color:var(--text3)}
.protocol span{padding:2px 6px;border-radius:4px}
.protocol .on{background:var(--content);color:var(--text);box-shadow:0 1px 1px rgba(0,0,0,.1)}
.welcome-tip{display:flex;align-items:flex-start;gap:8px;margin-top:26px;padding:10px 12px;max-width:600px;border:1px solid var(--line);border-radius:8px;background:var(--panel);font-size:10.5px;color:var(--text2);line-height:1.45}
.welcome-tip .ico{color:var(--accent);flex:none;margin-top:1px}
.welcome-tip b{color:var(--text);font-weight:600}
.wbadge{display:inline-flex;align-items:center;gap:3px;height:16px;padding:0 5px;border-radius:4px;background:var(--accent-soft);color:var(--accent);font-size:8.5px;font-weight:600;letter-spacing:.02em}
.wshortcut{font-size:9.5px;color:var(--text3);margin-left:6px}

/* ---------- misc ---------- */
.mono{font-family:var(--mono)}
.muted{color:var(--text2)}
.dim{color:var(--text3)}
.small{font-size:10.5px}
.tnum{font-variant-numeric:tabular-nums}
.truncate{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.spacer{flex:1}
.hidden{display:none!important}
.status-dot{width:6px;height:6px;border-radius:50%;background:var(--ok);flex:none}
.tagicon{width:8px;height:8px;border-radius:2px;background:currentColor;opacity:.8;flex:none}

@media (prefers-reduced-motion:reduce){
  .window{animation:none}
  *{transition:none!important}
}
@media (max-width:1080px){
  .insp{width:320px}
  .insp.wide{width:350px}
  .search{width:140px}
}
@media (max-width:860px){
  .desktop{padding:12px}
  .window{height:calc(100vh - 24px);border-radius:10px}
  .sidebar{display:none}
  .insp{display:none}
  .wside{display:none}
  .wmain{padding:30px 24px}
  .clone-grid{grid-template-columns:1fr}
  .clone-grid .full{grid-column:auto}
  .seg .lbl{display:none}
}

/* mixed split-diff cells */
.dtable td.delcell{background:var(--del-bg)}
.dtable td.delcell.ln{background:var(--del-ln);color:var(--del-fg)}
.dtable td.addcell{background:var(--add-bg)}
.dtable td.addcell.ln{background:var(--add-ln);color:var(--add-fg)}

/* native-feeling overlay scrollbars */
.diffbody::-webkit-scrollbar,.fileview::-webkit-scrollbar,.insp-body::-webkit-scrollbar,.side-scroll::-webkit-scrollbar,.agent-scroll::-webkit-scrollbar,.wmain::-webkit-scrollbar{width:11px;height:11px}
.diffbody::-webkit-scrollbar-thumb,.fileview::-webkit-scrollbar-thumb,.insp-body::-webkit-scrollbar-thumb,.side-scroll::-webkit-scrollbar-thumb,.agent-scroll::-webkit-scrollbar-thumb,.wmain::-webkit-scrollbar-thumb{background:rgba(0,0,0,.16);border:3px solid transparent;background-clip:content-box;border-radius:8px}
.theme-dark .diffbody::-webkit-scrollbar-thumb,.theme-dark .fileview::-webkit-scrollbar-thumb,.theme-dark .insp-body::-webkit-scrollbar-thumb,.theme-dark .side-scroll::-webkit-scrollbar-thumb,.theme-dark .agent-scroll::-webkit-scrollbar-thumb,.theme-dark .wmain::-webkit-scrollbar-thumb{background:rgba(255,255,255,.18);border:3px solid transparent;background-clip:content-box}
.diffbody::-webkit-scrollbar-corner,.insp-body::-webkit-scrollbar-corner,.side-scroll::-webkit-scrollbar-corner,.agent-scroll::-webkit-scrollbar-corner,.wmain::-webkit-scrollbar-corner{background:transparent}

/* clickable prototype: anchors reused as native controls */
a.btn,a.tbtn,a.chipbtn,a.itab,a.file-row,a.side-row,a.wrepo,a.mi,a.iconbtn,a.go,a.tabadd,a.tb-icon{cursor:default}
a:focus-visible{outline:none;box-shadow:var(--focus);border-radius:6px}

/* === v2: titlebar tabs, denser sidebar, tree modes, command palette, settings === */
.titlebar.with-tabs{height:44px;padding:0 13px;gap:9px}
.titlebar.with-tabs .lights{flex:none}
.title-tabs{height:100%;display:flex;align-items:center;gap:4px;min-width:0;margin-left:4px;overflow:hidden;flex:1}
.title-tabs .tabadd{flex:none}
.titlebar.with-tabs .win-title{position:static;transform:none;left:auto;display:none}
.titlebar.with-tabs .title-right{margin-left:8px;flex:none}
.tab-overflow{width:22px;height:24px;display:flex;align-items:center;justify-content:center;border-radius:5px;color:var(--text3);flex:none}
.tab-overflow:hover{background:var(--hover)}
.tabbar{display:none}

.toolbar.v2{height:44px;padding:0 10px}
.toolbar.v2 .tbtn{height:26px}
.toolbar.v2 .seg{order:2}
.mode-pill{display:flex;align-items:center;gap:0;padding:2px;background:var(--panel-2);border:1px solid var(--line-soft);border-radius:7px;flex:none}
.mode-pill a,.mode-pill span{height:22px;padding:0 8px;display:flex;align-items:center;gap:3px;border-radius:5px;font-size:11.5px;font-weight:500;color:var(--text2);white-space:nowrap;text-decoration:none}
.mode-pill .on{background:var(--content);color:var(--text);box-shadow:0 1px 2px rgba(0,0,0,.13),0 0 0 .5px rgba(0,0,0,.05)}
.mode-pill .count{font-size:9.5px;line-height:1;color:var(--text3);font-variant-numeric:tabular-nums;padding:0 1px}
.mode-pill .on .count{color:var(--accent-2)}
.toolbar .agent-slot{margin-left:6px}

.side-head.tight{height:24px;margin-top:12px}
.side-row{height:25px}
.side-row .sub{font-size:9.5px;color:var(--text3);margin-left:auto;white-space:nowrap}
.side-worktree .di{color:var(--purple)}
.side-sub .di{color:var(--accent)}
.side-empty{display:flex;align-items:center;gap:5px;height:24px;padding:0 8px;color:var(--text3);font-size:10.5px}

/* directory / list toggle */
.tree-toggle{display:flex;align-items:center;gap:2px;padding:2px;background:var(--panel-2);border:1px solid var(--line-soft);border-radius:5px}
.tree-toggle button{width:22px;height:18px;display:flex;align-items:center;justify-content:center;border-radius:4px;color:var(--text3)}
.tree-toggle button.on{background:var(--content);color:var(--text);box-shadow:0 1px 1px rgba(0,0,0,.12)}
.tree-toggle button:hover{color:var(--text)}
.flat-row{display:flex;align-items:center;gap:7px;height:27px;padding:0 7px;border-radius:5px;font-size:11.5px;color:var(--text);white-space:nowrap}
.flat-row:hover{background:var(--hover)}
.flat-row .path{font-family:var(--mono);font-size:10px;color:var(--text2);overflow:hidden;text-overflow:ellipsis}
.flat-row .path b{color:var(--text);font-weight:500}
.flat-row .st{margin-left:auto}
.dir-empty{display:flex;align-items:center;gap:6px;padding:8px 9px;margin:3px 0 5px;border:1px dashed var(--line-strong);border-radius:6px;color:var(--text3);font-size:10px}
.dir-empty b{color:var(--text2);font-weight:500}
.merge-note{display:flex;align-items:center;gap:6px;margin:5px 2px 1px;padding:5px 7px;border-radius:5px;background:var(--panel-2);color:var(--text3);font-size:9.5px}
.merge-note .sw{width:8px;height:8px;border-radius:2px;background:var(--purple);opacity:.7;flex:none}
.file-row .expand{width:10px;display:flex;align-items:center;justify-content:center;color:var(--text3);flex:none}

/* command palette */
.palette-layer{position:absolute;inset:0;z-index:60;background:rgba(20,22,28,.18);backdrop-filter:blur(2px)}
.palette{position:absolute;left:50%;top:92px;transform:translateX(-50%);width:620px;max-width:calc(100% - 48px);background:var(--menu-bg);border:1px solid var(--line-strong);border-radius:12px;box-shadow:0 30px 80px rgba(0,0,0,.34),0 4px 14px rgba(0,0,0,.16);overflow:hidden}
.palette-input{height:50px;display:flex;align-items:center;gap:9px;padding:0 14px;border-bottom:1px solid var(--line);color:var(--text3)}
.palette-input input{flex:1;min-width:0;border:0;outline:0;background:transparent;font-size:14px;color:var(--text)}
.palette-input input::placeholder{color:var(--text3)}
.palette-input .esc{font-size:9px;color:var(--text3);border:1px solid var(--line);border-radius:4px;padding:1px 5px}
.palette-body{max-height:390px;overflow:auto;padding:5px}
.palette-label{height:23px;display:flex;align-items:center;gap:6px;padding:0 8px;font-size:9px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--text3)}
.palette-row{display:flex;align-items:center;gap:9px;height:44px;padding:0 9px;border-radius:7px}
.palette-row:hover,.palette-row.on{background:var(--sel)}
.palette-row .pi{width:26px;height:26px;border-radius:6px;background:var(--panel);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;color:var(--text2);flex:none}
.palette-row.on .pi{background:var(--content);border-color:var(--line-strong);color:var(--accent)}
.palette-row .pt{min-width:0;flex:1}
.palette-row .pn{font-size:12px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.palette-row .pp{font-family:var(--mono);font-size:9.5px;color:var(--text3);margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.palette-row .pb{font-size:9px;color:var(--text3);background:var(--panel);border:1px solid var(--line);border-radius:4px;padding:1px 5px;white-space:nowrap}
.palette-row .penter{font-size:10px;color:var(--text3);margin-left:4px}
.palette-foot{height:30px;display:flex;align-items:center;gap:10px;padding:0 12px;border-top:1px solid var(--line);color:var(--text3);font-size:9px;background:var(--panel)}
.palette-foot .spacer{flex:1}
.palette-foot kbd{font-family:var(--sans);font-size:8.5px;border:1px solid var(--line);border-radius:3px;padding:0 4px;line-height:13px;background:var(--content)}

/* settings window */
.settings .window{width:min(920px,100%);height:min(700px,calc(100vh - 48px))}
.settings-body{flex:1;display:flex;min-height:0}
.settings-side{width:208px;flex:none;background:var(--sidebar);border-right:1px solid var(--line);padding:12px 8px;overflow:auto}
.settings-side .sg{height:24px;display:flex;align-items:center;padding:0 8px;margin-top:8px;font-size:9px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--text3)}
.settings-nav{display:flex;align-items:center;gap:7px;height:28px;padding:0 8px;border-radius:6px;font-size:12px;color:var(--text);white-space:nowrap}
.settings-nav:hover{background:var(--hover)}
.settings-nav.on{background:var(--sel);font-weight:500}
.settings-nav .si{width:16px;display:flex;align-items:center;justify-content:center;color:var(--text3)}
.settings-nav.on .si{color:var(--accent)}
.settings-main{flex:1;min-width:0;overflow:auto;padding:24px 28px;background:var(--content)}
.settings-title{font-size:17px;font-weight:700;letter-spacing:-.015em;color:var(--text);margin:0}
.settings-sub{font-size:11px;color:var(--text3);margin-top:4px}
.settings-sec{margin-top:20px;padding-top:16px;border-top:1px solid var(--line)}
.settings-sec:first-of-type{border-top:0;margin-top:14px;padding-top:0}
.settings-sec-title{font-size:12px;font-weight:600;color:var(--text);margin-bottom:2px}
.settings-sec-sub{font-size:10px;color:var(--text3);margin-bottom:12px}
.set-row{display:flex;align-items:flex-start;gap:14px;padding:11px 0;border-bottom:1px solid var(--line-soft)}
.set-row:last-child{border-bottom:0}
.set-row .sl{flex:1;min-width:0}
.set-row .sl b{display:block;font-size:11.5px;font-weight:500;color:var(--text)}
.set-row .sl span{display:block;font-size:9.5px;color:var(--text3);margin-top:2px;line-height:1.4}
.set-row .sr{flex:none;display:flex;align-items:center;gap:6px}
.set-field{height:26px;min-width:220px;display:flex;align-items:center;gap:6px;padding:0 8px;background:var(--field);border:1px solid var(--field-border);border-radius:6px;color:var(--text3)}
.set-field input{flex:1;min-width:0;border:0;outline:0;background:transparent;font-size:11px;color:var(--text)}
.set-field .mono{font-family:var(--mono);font-size:10px}
.set-select{height:26px;padding:0 24px 0 8px;display:flex;align-items:center;gap:6px;background:var(--field);border:1px solid var(--field-border);border-radius:6px;font-size:11px;color:var(--text);white-space:nowrap}
.set-select .ch{margin-left:auto;color:var(--text3)}
.radio-pills{display:flex;padding:2px;gap:2px;background:var(--panel-2);border:1px solid var(--line-soft);border-radius:7px}
.radio-pills a,.radio-pills span{height:22px;padding:0 10px;display:flex;align-items:center;gap:5px;border-radius:5px;font-size:10.5px;color:var(--text2);white-space:nowrap}
.radio-pills .on{background:var(--content);color:var(--text);box-shadow:0 1px 2px rgba(0,0,0,.12)}
.settings-scan{margin-top:12px;border:1px solid var(--line);border-radius:8px;overflow:hidden}
.scan-head{height:28px;display:flex;align-items:center;gap:6px;padding:0 9px;background:var(--panel-2);border-bottom:1px solid var(--line-soft);font-size:10px;font-weight:600;color:var(--text2)}
.scan-head .cnt{margin-left:auto;font-weight:500;color:var(--text3)}
.scan-row{height:30px;display:flex;align-items:center;gap:8px;padding:0 9px;border-bottom:1px solid var(--line-soft);font-size:11px;color:var(--text)}
.scan-row:last-child{border-bottom:0}
.scan-row .repo{font-weight:500}
.scan-row .path{font-family:var(--mono);font-size:9.5px;color:var(--text3);margin-left:auto}
.scan-row input{accent-color:var(--accent)}
.settings-foot{height:44px;flex:none;display:flex;align-items:center;gap:8px;padding:0 16px;border-top:1px solid var(--line);background:var(--panel)}
.settings-foot .spacer{flex:1}

/* changelists (IDEA-style) */
.cl-select{height:27px;max-width:250px;display:flex;align-items:center;gap:6px;padding:0 7px;border:1px solid var(--line);background:var(--field);border-radius:6px;font-size:11.5px;font-weight:500;color:var(--text);white-space:nowrap;text-decoration:none}
.cl-select:hover{background:var(--panel)}
.cl-select .cl-dot{width:7px;height:7px;border-radius:50%;background:var(--accent);flex:none}
.cl-select .cl-count{font-size:9.5px;color:var(--text3);background:var(--panel-2);border-radius:4px;padding:0 4px;line-height:14px;font-weight:500}
.cl-select .chev{color:var(--text3);flex:none}
.cl-plus{width:23px;height:23px;display:flex;align-items:center;justify-content:center;border-radius:5px;color:var(--text2);flex:none}
.cl-plus:hover{background:var(--hover)}
.cl-group{height:24px;display:flex;align-items:center;gap:6px;padding:0 8px;background:var(--panel);border-bottom:1px solid var(--line-soft);font-size:9.5px;font-weight:600;letter-spacing:.03em;text-transform:uppercase;color:var(--text3)}
.cl-group .cl-dot{width:7px;height:7px;border-radius:50%;background:var(--text3);flex:none}
.cl-group.active{background:var(--accent-soft)}
.cl-group.active .cl-dot{background:var(--accent)}
.cl-group .cl-name{font-size:10px;font-weight:600;letter-spacing:0;text-transform:none;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cl-group.active .cl-name{color:var(--text)}
.cl-group .cl-count{margin-left:2px;font-weight:500;letter-spacing:0;text-transform:none;color:var(--text3);font-variant-numeric:tabular-nums}
.cl-group .spacer{flex:1}
.cl-more{width:18px;height:17px;border-radius:4px;display:flex;align-items:center;justify-content:center;color:var(--text3);font-size:12px;line-height:1}
.cl-more:hover{background:var(--hover);color:var(--text)}
.cl-pop{position:absolute;top:37px;left:8px;width:320px;z-index:35;background:var(--menu-bg);border:1px solid var(--line-strong);border-radius:9px;box-shadow:var(--shadow-menu);padding:5px;backdrop-filter:blur(24px)}
.cl-pop-head{height:30px;display:flex;align-items:center;gap:6px;padding:0 7px;font-size:11px;font-weight:600;color:var(--text)}
.cl-pop-head .add{margin-left:auto;color:var(--accent-2);font-weight:500;font-size:10px;display:flex;align-items:center;gap:3px}
.cl-row{width:100%;height:28px;display:flex;align-items:center;gap:7px;padding:0 8px;border-radius:5px;font-size:11.5px;color:var(--text);text-align:left;white-space:nowrap;text-decoration:none;font:inherit}
.cl-row:hover{background:var(--hover)}
.cl-row .cl-radio{width:12px;height:12px;border-radius:50%;border:1px solid var(--line-strong);flex:none;display:flex;align-items:center;justify-content:center}
.cl-row.active{font-weight:600}
.cl-row.active .cl-radio{border-color:var(--accent);background:var(--accent);box-shadow:inset 0 0 0 2px var(--menu-bg)}
.cl-row .cl-pc{margin-left:auto;font-size:9.5px;color:var(--text3);font-weight:500}
.cl-row .cl-more{color:var(--text3);padding:0 2px}
.cl-pop-foot{display:flex;align-items:center;gap:5px;padding:6px 7px 3px;margin-top:4px;border-top:1px solid var(--line-soft)}
.cl-pop-foot .hint{margin-right:auto;font-size:9px}
a.cl-select,a.cl-plus,a.cl-row{cursor:default}

/* === v3: filters, theme tiles, dialogs, galleries, shortcuts === */
.theme-grid{display:flex;gap:8px;flex-wrap:wrap}
.theme-tile{width:118px;padding:5px;border:1px solid var(--line);border-radius:8px;background:var(--content);color:var(--text2);text-align:center;font-size:10px;transition:border-color .12s ease,box-shadow .12s ease}
.theme-tile:hover{border-color:var(--line-strong)}
.theme-tile.on{border-color:var(--accent);box-shadow:0 0 0 2px rgba(0,122,255,.16);color:var(--text)}
.theme-tile .tp{height:50px;border-radius:5px;border:1px solid var(--line);overflow:hidden;position:relative;background:#fff;margin-bottom:5px}
.theme-tile .tp .bar{height:10px;background:#f1f1f3;border-bottom:1px solid #e5e5e9;position:relative;z-index:2}
.theme-tile .tp .side{position:absolute;left:0;top:10px;bottom:0;width:31%;background:#f5f5f7;border-right:1px solid #e5e5e9}
.theme-tile .tp .ln{position:absolute;left:39%;right:9%;height:3px;border-radius:2px;background:#e9e9ee}
.theme-tile .tp .ln.a{top:18px;right:30%}
.theme-tile .tp .ln.b{top:26px}
.theme-tile .tp .ln.c{top:34px;right:48%}
.theme-tile.dark .tp{background:#1b1b1d;border-color:#3a3a3d}
.theme-tile.dark .tp .bar{background:#262628;border-color:#3a3a3d}
.theme-tile.dark .tp .side{background:#232325;border-color:#3a3a3d}
.theme-tile.dark .tp .ln{background:#3a3a3e}
.theme-tile.auto .tp{background:linear-gradient(90deg,#fff 50%,#1b1b1d 50%)}
.theme-tile.auto .tp .bar{background:linear-gradient(90deg,#f1f1f3 50%,#262628 50%)}
.theme-tile.auto .tp .side{background:linear-gradient(90deg,#f5f5f7 50%,#232325 50%)}

.date-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.date-opt{border:1px solid var(--line);background:var(--content);border-radius:7px;padding:7px 9px;text-align:left;color:var(--text)}
.date-opt b{display:block;font-size:11px;font-weight:500}
.date-opt span{display:block;font-family:var(--mono);font-size:9px;color:var(--text3);margin-top:2px}
.date-opt.on{border-color:var(--accent);background:var(--accent-soft)}
.date-opt.on b{color:var(--text)}
.pattern-row{display:flex;align-items:center;gap:8px;margin-top:8px}
.pattern-row .set-field{flex:1;max-width:none}

.filter-pop{position:absolute;top:38px;left:12px;width:432px;z-index:45;background:var(--menu-bg);border:1px solid var(--line-strong);border-radius:10px;box-shadow:var(--shadow-menu);overflow:hidden}
.fp-head{height:38px;display:flex;align-items:center;gap:7px;padding:0 12px;border-bottom:1px solid var(--line);background:var(--titlebar);font-size:12px;font-weight:600;color:var(--text)}
.fp-head .x{margin-left:auto;color:var(--text3);font-size:10px;font-weight:500}
.fp-body{padding:10px 12px 12px;max-height:430px;overflow:auto}
.fp-sec{padding:9px 0;border-bottom:1px solid var(--line-soft)}
.fp-sec:last-child{border-bottom:0}
.fp-lab{display:flex;align-items:center;gap:6px;font-size:9px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--text3);margin-bottom:5px}
.fp-lab .spacer{flex:1}
.fp-lab .lnk{font-size:9px;font-weight:500;letter-spacing:0;text-transform:none;color:var(--accent-2)}
.fp-branch{height:26px;display:flex;align-items:center;gap:7px;padding:0 4px;border-radius:5px;font-size:11px;color:var(--text)}
.fp-branch:hover{background:var(--hover)}
.fp-branch .dot{width:7px;height:7px;border-radius:50%;flex:none}
.fp-branch .nm{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fp-branch .cur{margin-left:auto;font-size:8.5px;color:var(--accent);font-weight:600}
.fp-seg{display:flex;gap:2px;padding:2px;background:var(--panel-2);border:1px solid var(--line-soft);border-radius:6px}
.fp-seg button,.fp-seg span{height:20px;padding:0 7px;display:flex;align-items:center;border-radius:4px;font-size:9.5px;color:var(--text2);white-space:nowrap}
.fp-seg .on{background:var(--content);color:var(--text);box-shadow:0 1px 1px rgba(0,0,0,.1)}
.fp-range{display:flex;align-items:center;gap:6px;margin-top:7px}
.fp-range .field{height:25px;flex:1}
.fp-range .field input{font-family:var(--mono);font-size:9.5px}
.cal{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:2px;margin-top:7px}
.cal .wd{height:16px;display:flex;align-items:center;justify-content:center;font-size:8.5px;color:var(--text3)}
.cal .d{height:22px;display:flex;align-items:center;justify-content:center;border-radius:4px;font-size:9.5px;color:var(--text2);font-variant-numeric:tabular-nums}
.cal .d:hover{background:var(--hover)}
.cal .d.mut{color:var(--text3);opacity:.5}
.cal .d.on{background:var(--accent);color:#fff}
.cal .d.today{outline:1px solid var(--accent);outline-offset:-1px}
.fp-field{height:26px;display:flex;align-items:center;gap:6px;padding:0 7px;border:1px solid var(--field-border);background:var(--field);border-radius:5px;color:var(--text3)}
.fp-field input{flex:1;min-width:0;border:0;outline:0;background:transparent;font-size:10px;color:var(--text)}
.fp-foot{height:42px;display:flex;align-items:center;gap:7px;padding:0 12px;border-top:1px solid var(--line);background:var(--panel)}
.fp-foot .spacer{flex:1}
.fp-foot .hint{font-size:9px}

/* galleries and dialogs */
.gallery-page{min-height:100vh;box-sizing:border-box;padding:30px 34px;background:linear-gradient(180deg,#eef0f4,#dfe3ea);display:flex;flex-direction:column;gap:14px;font-family:var(--sans)}
.gallery-title{font-size:20px;font-weight:700;letter-spacing:-.015em;color:#1d1d1f;margin:0}
.gallery-sub{font-size:10.5px;color:#5d5d65;margin-top:2px}
.gallery-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px;flex:1;min-height:0}
.gallery-cell{display:flex;flex-direction:column;gap:7px;min-width:0}
.gallery-cap{font-size:9px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:#6e6e76;display:flex;align-items:center;gap:6px}
.gallery-cap .sw{width:7px;height:7px;border-radius:2px;background:#0a66e8;opacity:.7}
.dialog{background:var(--content);border:1px solid var(--line-strong);border-radius:10px;box-shadow:0 14px 34px rgba(20,24,32,.16),0 2px 6px rgba(20,24,32,.08);overflow:hidden;flex:none}
.dialog-head{height:44px;display:flex;align-items:center;gap:8px;padding:0 14px;border-bottom:1px solid var(--line);background:var(--titlebar)}
.dialog-head .t{font-size:12px;font-weight:600;color:var(--text)}
.dialog-head .s{font-size:9px;color:var(--text3)}
.dialog-head .x{margin-left:auto;color:var(--text3);font-size:14px}
.dialog-body{padding:11px 14px}
.dialog-foot{height:42px;display:flex;align-items:center;gap:7px;padding:0 14px;border-top:1px solid var(--line);background:var(--panel)}
.dialog-foot .spacer{flex:1}
.dialog-note{font-size:9px;color:var(--text3);margin-top:5px;line-height:1.45}
.dialog .field{height:26px}
.dialog .label{display:block;margin-bottom:4px}
.dialog .textarea{min-height:58px;font-size:11px}
.menu.flat{position:relative;left:0;top:0;width:252px;box-shadow:0 10px 26px rgba(20,24,32,.14)}
.compare-card{background:var(--content);border:1px solid var(--line-strong);border-radius:10px;box-shadow:0 10px 26px rgba(20,24,32,.12);overflow:hidden;max-width:560px}
.compare-head{height:38px;display:flex;align-items:center;gap:7px;padding:0 12px;border-bottom:1px solid var(--line);background:var(--titlebar);font-size:11px;font-weight:600;color:var(--text)}
.compare-body{padding:12px}
.branch-pair{display:flex;align-items:center;gap:8px;font-family:var(--mono);font-size:10.5px;color:var(--text)}
.branch-pair .ar{color:var(--text3)}
.compare-stats{display:flex;gap:10px;margin-top:8px;font-size:10px;color:var(--text3)}
.shortcut-keys{display:flex;align-items:center;gap:3px}
.shortcut-keys .kbd{min-width:18px;text-align:center;font-size:9px;padding:0 4px;line-height:16px}
.shortcut-row .sr{gap:8px}

/* shortcut recording state */
.shortcut-recorder{margin-top:10px;border:1px solid var(--accent);border-radius:8px;background:var(--accent-soft);padding:9px 11px}
.shortcut-recorder .rr-head{display:flex;align-items:center;gap:7px;font-size:10.5px;color:var(--text2)}
.shortcut-recorder .rr-head b{color:var(--text);font-weight:600}
.rec-keys{display:flex;align-items:center;gap:4px;margin:7px 0 5px}
.rec-keys .kbd{font-size:10px;line-height:18px;padding:0 6px;border-color:var(--line-strong);background:var(--content)}
.rec-caret{width:2px;height:16px;background:var(--accent);margin-left:1px;animation:rec-blink 1.05s steps(2) infinite}
@keyframes rec-blink{50%{opacity:0}}
.shortcut-recorder .rr-foot{display:flex;align-items:center;gap:6px;font-size:9px;color:var(--text3)}

/* ---------- P0: staging, operation banners ---------- */
.stage-sec-head{display:flex;align-items:center;gap:6px;height:24px;padding:0 8px;border-bottom:1px solid var(--line-soft);background:var(--panel-2);flex:none}
.stage-sec-head .st{width:12px;height:12px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;background:var(--ok);color:#fff;flex:none}
.stage-sec-head .st.empty{background:transparent;border:1px solid var(--line-strong)}
.stage-sec-head .nm{font-size:10px;font-weight:600;color:var(--text)}
.stage-sec-head .n{font-size:9px;color:var(--text3)}
.stage-sec-head .lnk{margin-left:auto;border:0;background:none;padding:0;font-size:9.5px;color:var(--accent);font-weight:500;cursor:default}
.line-act{display:inline-block;margin-left:10px;padding:0 5px;border:1px solid var(--line);border-radius:4px;background:var(--content);font-size:8.5px;line-height:14px;color:var(--text3);white-space:nowrap;vertical-align:1px}

.op-banner{display:flex;align-items:center;gap:7px;height:30px;flex:none;padding:0 12px;border-bottom:1px solid var(--line);background:var(--accent-soft);font-size:10px;color:var(--text2);z-index:5}
.op-banner.warn{background:color-mix(in srgb,var(--warn) 11%,var(--content))}
.op-banner .op-ic{display:inline-flex;width:14px;height:14px;color:var(--accent);flex:none}
.op-banner.warn .op-ic{color:var(--warn)}
.op-banner b{color:var(--text);font-weight:600}
.op-banner .spacer{flex:1}
.op-banner .btn{height:20px;font-size:9.5px;padding:0 7px}

/* ---------- P0: merge conflict ---------- */
.merge-layer{position:absolute;inset:0;z-index:60;background:rgba(0,0,0,.34);display:flex;align-items:flex-start;justify-content:center;padding:22px 34px}
.merge-sheet{width:100%;max-width:1320px;height:772px;background:var(--content);border:1px solid var(--line);border-radius:12px;box-shadow:0 30px 80px rgba(0,0,0,.35);display:flex;flex-direction:column;overflow:hidden}
.merge-head{height:46px;display:flex;align-items:center;gap:9px;padding:0 14px;border-bottom:1px solid var(--line);background:var(--panel);flex:none}
.merge-head .t{font-size:13px;font-weight:600;letter-spacing:-.01em;color:var(--text)}
.merge-head .s{font-size:10px;color:var(--text3);margin-top:1px}
.merge-badge{display:inline-flex;align-items:center;height:18px;padding:0 6px;border-radius:4px;background:var(--accent-soft);color:var(--accent-2);font-size:8.5px;font-weight:700;letter-spacing:.05em}
.merge-head .x{margin-left:2px;width:24px;height:24px;border-radius:5px;display:inline-flex;align-items:center;justify-content:center;color:var(--text3);font-size:16px;text-decoration:none}
.merge-head .x:hover{background:var(--panel-2);color:var(--text)}
.merge-toolbar{height:38px;display:flex;align-items:center;gap:6px;padding:0 12px;border-bottom:1px solid var(--line);background:var(--content);flex:none}
.merge-toolbar .btn{height:22px;font-size:9.5px;padding:0 7px}
.merge-toolbar .hint{margin:0 4px}
.merge-body{flex:1;display:flex;min-height:0}
.conflict-list{width:224px;flex:none;border-right:1px solid var(--line);background:var(--panel);display:flex;flex-direction:column;min-height:0}
.conflict-head{height:30px;flex:none;display:flex;align-items:center;gap:6px;padding:0 10px;border-bottom:1px solid var(--line-soft);font-size:9.5px;font-weight:600;color:var(--text2);text-transform:uppercase;letter-spacing:.05em}
.conflict-head .n{margin-left:auto;font-size:9px;color:var(--text3);font-weight:500;letter-spacing:0;text-transform:none}
.conflict-list .scroll{flex:1;overflow:auto;padding:5px}
.conflict-row{width:100%;display:flex;align-items:center;gap:6px;height:27px;padding:0 6px;border:0;border-radius:5px;background:none;text-align:left;font:inherit;font-size:10px;color:var(--text2);cursor:default}
.conflict-row.on{background:var(--sel);color:var(--text)}
.conflict-row .dot{width:6px;height:6px;border-radius:50%;background:var(--danger);flex:none}
.conflict-row .dot.ok{background:var(--ok)}
.conflict-row .nm{font-family:var(--mono);font-size:9.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.conflict-row .n{margin-left:auto;font-size:9px;color:var(--text3)}
.conflict-summary{margin-top:auto;padding:9px 10px;border-top:1px solid var(--line-soft);font-size:9px;color:var(--text3);line-height:1.5}
.merge-main{flex:1;min-width:0;display:flex;flex-direction:column}
.merge-base{height:62px;flex:none;border-bottom:1px solid var(--line);background:var(--panel-2);display:flex;align-items:stretch;overflow:hidden}
.merge-base .lab{width:86px;flex:none;padding:8px 10px;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:3px}
.merge-base .lab b{font-size:9px;letter-spacing:.05em;text-transform:uppercase;color:var(--text3);font-weight:600}
.merge-base .lab span{font-family:var(--mono);font-size:9px;color:var(--text2)}
.merge-base .bc{flex:1;padding:7px 10px;font-family:var(--mono);font-size:9.5px;line-height:15px;color:var(--text3);overflow:hidden;white-space:pre}
.merge-base .ba{display:flex;align-items:flex-start;padding:7px 8px}
.merge-panes{flex:1;display:grid;grid-template-columns:1fr 1.1fr 1fr;min-height:0}
.merge-pane{min-width:0;display:flex;flex-direction:column;border-right:1px solid var(--line);min-height:0}
.merge-pane:last-child{border-right:0}
.merge-pane.result{background:var(--content)}
.pane-head{height:30px;flex:none;display:flex;align-items:center;gap:6px;padding:0 9px;border-bottom:1px solid var(--line-soft);background:var(--panel)}
.pane-head .nm{font-size:10px;font-weight:600;color:var(--text)}
.pane-head .ref{font-family:var(--mono);font-size:8.5px;color:var(--text3)}
.pane-head .n{margin-left:auto;font-size:9px;color:var(--text3)}
.merge-code{flex:1;overflow:auto;padding:7px 0;background:var(--content);font-family:var(--mono);font-size:10px;line-height:18px;min-height:0;color:var(--text2)}
.merge-code .cl{display:flex;gap:8px;padding:0 8px;white-space:pre}
.merge-code .cl .ln{width:22px;flex:none;text-align:right;color:var(--text3);user-select:none}
.merge-code .cl .cd{flex:1;min-width:0}
.merge-code .cl.ours{background:color-mix(in srgb,var(--accent) 9%,transparent)}
.merge-code .cl.theirs{background:color-mix(in srgb,var(--ok) 10%,transparent)}
.merge-code .cl.add{background:color-mix(in srgb,var(--ok) 10%,transparent)}
.merge-code .cl.del{background:color-mix(in srgb,var(--danger) 8%,transparent)}
.merge-code .cl.marker{color:var(--text3);font-size:9px;height:18px;line-height:18px}
.merge-code .cl.marker.ours{color:var(--accent-2)}
.merge-code .cl.marker.theirs{color:var(--ok)}
.merge-result{outline:0;background:var(--content);border-left:1px solid var(--accent);border-right:1px solid var(--accent)}
.merge-result:focus{box-shadow:inset 0 0 0 1px var(--accent)}
.merge-result .cl{min-height:18px}
.merge-caret{display:inline-block;width:1.5px;height:14px;background:var(--accent);vertical-align:-2px;margin-left:1px;animation:merge-caret 1.05s steps(2) infinite}
@keyframes merge-caret{50%{opacity:0}}
.merge-foot{height:46px;flex:none;display:flex;align-items:center;gap:8px;padding:0 14px;border-top:1px solid var(--line);background:var(--panel)}
.merge-foot .unresolved{display:inline-flex;align-items:center;gap:6px;font-size:10px;color:var(--text2)}
.merge-foot .unresolved .status-dot{background:var(--danger)}
.merge-foot .spacer{flex:1}
.merge-foot .btn{height:26px;font-size:10px}
.merge-foot .btn.primary:disabled{opacity:.45;box-shadow:none}

/* ---------- P0: sync ---------- */
.sync-layer{position:absolute;inset:0;z-index:60;background:rgba(0,0,0,.28);display:flex;align-items:center;justify-content:center;padding:24px}
.sync-sheet{width:800px;max-width:calc(100% - 40px);height:520px;background:var(--content);border:1px solid var(--line);border-radius:12px;box-shadow:0 30px 80px rgba(0,0,0,.32);display:flex;flex-direction:column;overflow:hidden}
.sync-head{height:46px;flex:none;display:flex;align-items:center;gap:10px;padding:0 12px 0 14px;border-bottom:1px solid var(--line);background:var(--panel)}
.sync-title{font-size:13px;font-weight:600;letter-spacing:-.01em;color:var(--text)}
.sync-tabs{display:flex;align-items:center;gap:1px;margin-left:4px;padding:2px;background:var(--panel-2);border:1px solid var(--line-soft);border-radius:6px}
.sync-tab{height:22px;padding:0 10px;border:0;border-radius:4px;background:none;font:inherit;font-size:9.5px;color:var(--text2);cursor:default}
.sync-tab.on{background:var(--content);color:var(--text);box-shadow:0 1px 2px rgba(0,0,0,.08);font-weight:600}
.sync-close{width:24px;height:24px;border-radius:5px;display:inline-flex;align-items:center;justify-content:center;color:var(--text3);font-size:16px;text-decoration:none;margin-left:auto}
.sync-close:hover{background:var(--panel-2);color:var(--text)}
.sync-body{flex:1;display:grid;grid-template-columns:1fr 1fr;min-height:0}
.sync-main{padding:14px;min-width:0;display:flex;flex-direction:column;gap:10px}
.sync-side{padding:14px;border-left:1px solid var(--line);background:var(--panel);min-width:0;display:flex;flex-direction:column;gap:9px}
.sync-kicker{font-size:8.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--text3)}
.sync-target{display:flex;align-items:center;gap:7px;font-size:11px;color:var(--text2)}
.sync-target .ref{font-family:var(--mono);font-size:10px;color:var(--text)}
.sync-target .btn{margin-left:auto}
.sync-line{display:flex;align-items:center;gap:6px;font-size:10px;color:var(--text3);border-top:1px solid var(--line-soft);padding-top:8px}
.sync-line b{color:var(--text);font-weight:500}
.sync-line .spacer{flex:1}
.sync-options{display:flex;flex-direction:column;gap:4px;padding:8px 0;border-top:1px solid var(--line-soft)}
.sync-auth{display:flex;align-items:center;gap:6px;font-size:9.5px;color:var(--ok);margin-top:auto}
.sync-auth .status-dot{background:var(--ok)}
.sync-action{display:flex;gap:6px;align-items:center}
.sync-action .btn.primary{flex:1;justify-content:center}
.sync-progress{height:4px;border-radius:2px;background:var(--panel-2);overflow:hidden;margin:2px 0 4px}
.sync-progress i{display:block;height:100%;background:var(--accent);border-radius:2px}
.sync-log{flex:1;overflow:auto;font-family:var(--mono);font-size:9px;line-height:16px;color:var(--text3);background:var(--content);border:1px solid var(--line-soft);border-radius:6px;padding:7px 8px;white-space:pre-wrap}
.sync-log b{color:var(--text2);font-weight:500}
.sync-activity{display:flex;align-items:center;gap:6px;font-size:10px;color:var(--text2)}
.sync-activity .spinner{width:10px;height:10px;border-radius:50%;border:1.5px solid var(--line);border-top-color:var(--accent);animation:spin .8s linear infinite}
.sync-foot{height:46px;flex:none;display:flex;align-items:center;gap:7px;padding:0 14px;border-top:1px solid var(--line);background:var(--panel)}
.sync-foot .spacer{flex:1}
.sync-foot .btn{height:26px;font-size:10px}

/* ---------- P0: repository states ---------- */
.state-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;flex:1;min-height:0}
.state-card{display:flex;flex-direction:column;gap:7px;min-width:0}
.state-cap{display:flex;align-items:center;gap:6px;font-size:9px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:#6e6e76}
.state-cap .sw{width:7px;height:7px;border-radius:2px;background:#0a66e8;opacity:.7}
.state-window{height:238px;border:1px solid #c9cdd6;border-radius:9px;background:var(--content);overflow:hidden;display:flex;flex-direction:column;box-shadow:0 8px 22px rgba(20,30,50,.08)}
.mini-titlebar{height:25px;flex:none;display:flex;align-items:center;gap:5px;padding:0 8px;background:var(--panel);border-bottom:1px solid var(--line)}
.mini-titlebar .tl{display:flex;gap:3px}
.mini-titlebar .tl i{width:6px;height:6px;border-radius:50%;display:block}
.mini-titlebar .tl i:nth-child(1){background:#ff5f57}.mini-titlebar .tl i:nth-child(2){background:#febc2e}.mini-titlebar .tl i:nth-child(3){background:#28c840}
.mini-titlebar .mt{font-size:8px;color:var(--text3);margin:0 auto;font-family:var(--sans)}
.mini-toolbar{height:22px;flex:none;display:flex;align-items:center;gap:5px;padding:0 8px;border-bottom:1px solid var(--line-soft);background:var(--content)}
.mini-toolbar .pill{height:11px;border-radius:3px;background:var(--panel-2);display:inline-block}
.mini-toolbar .pill.a{width:42px}.mini-toolbar .pill.b{width:24px}.mini-toolbar .pill.c{width:30px}
.mini-body{flex:1;display:flex;min-height:0}
.mini-side{width:64px;flex:none;border-right:1px solid var(--line);background:var(--sidebar);padding:6px 6px;display:flex;flex-direction:column;gap:5px}
.mini-side .sl{height:6px;border-radius:2px;background:var(--line-soft)}
.mini-side .sl.on{background:var(--accent-soft)}
.mini-main{flex:1;min-width:0;padding:8px;display:flex;flex-direction:column;gap:5px;position:relative}
.mini-banner{display:flex;align-items:center;gap:5px;min-height:24px;padding:4px 7px;border-radius:4px;background:var(--accent-soft);font-size:8px;color:var(--text2);line-height:1.3}
.mini-banner.warn{background:color-mix(in srgb,var(--warn) 12%,var(--content))}
.mini-banner.danger{background:color-mix(in srgb,var(--danger) 10%,var(--content))}
.mini-banner b{color:var(--text);font-weight:600}
.mini-banner .sp{flex:1}
.mini-banner .mini-btn{display:inline-flex;align-items:center;height:15px;padding:0 5px;border-radius:3px;background:var(--content);border:1px solid var(--line);font-size:7px;color:var(--text2);white-space:nowrap}
.mini-empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;text-align:center}
.mini-empty .me-ic{width:24px;height:24px;border-radius:6px;background:var(--accent-soft);display:flex;align-items:center;justify-content:center;color:var(--accent);margin-bottom:2px}
.mini-empty b{font-size:10px;color:var(--text);font-weight:600}
.mini-empty span{font-size:7.5px;color:var(--text3);line-height:1.35;max-width:170px}
.mini-empty .mini-btn{margin-top:3px;height:17px;padding:0 7px;border:1px solid var(--line);border-radius:4px;background:var(--content);font-size:7.5px;color:var(--text2);display:inline-flex;align-items:center}
.mini-row{display:flex;align-items:center;gap:5px;height:12px}
.mini-row .dot{width:4px;height:4px;border-radius:50%;background:var(--accent);flex:none}
.mini-row .bar{height:5px;border-radius:2px;background:var(--panel-2);display:block}
.mini-row .bar.a{width:52%}.mini-row .bar.b{width:35%}.mini-row .bar.c{width:70%}
.mini-row .hash{font-family:var(--mono);font-size:7px;color:var(--text3);background:none;border:0;padding:0}
.mini-skeleton{display:flex;flex-direction:column;gap:7px;padding:4px 0}
.sk{height:7px;border-radius:3px;background:linear-gradient(90deg,var(--panel-2) 25%,var(--line-soft) 37%,var(--panel-2) 63%);background-size:400% 100%;animation:sk 1.6s ease infinite}
.sk.a{width:70%}.sk.b{width:45%}.sk.c{width:88%}.sk.d{width:60%}
@keyframes sk{0%{background-position:100% 0}100%{background-position:-100% 0}}
@keyframes spin{to{transform:rotate(360deg)}}

/* ---------- tree/list staging + compact commits + merge file tree ---------- */
.changes-scroll{flex:1;overflow:auto;min-height:0}
.tree-dir{width:100%;height:24px;flex:none;display:flex;align-items:center;gap:5px;padding:0 8px;border:0;border-bottom:1px solid var(--line-soft);background:none;text-align:left;font:inherit;font-size:9.5px;color:var(--text2);cursor:default}
.tree-dir:hover{background:var(--hover)}
.tree-dir .tw{font-weight:500;color:var(--text2)}
.tree-dir .td-count{margin-left:auto;font-size:9px;color:var(--text3);font-variant-numeric:tabular-nums}
.staged-dir{height:22px;display:flex;align-items:center;gap:5px;padding:0 8px;border-bottom:1px solid var(--line-soft);background:var(--panel);font-size:9.5px;color:var(--text2)}
.staged-dir .sd-count{margin-left:auto;font-size:9px;color:var(--text3)}
.staged-file{padding-left:22px}
.commit.compact{height:32px}
.commit.compact .cg svg{height:32px;width:56px}

.merge-sheet{position:relative}
.merge-tree-pop{position:absolute;top:84px;right:12px;width:260px;background:var(--content);border:1px solid var(--line);border-radius:8px;box-shadow:0 16px 40px rgba(0,0,0,.22);z-index:20;overflow:hidden}
.mtp-head{height:34px;display:flex;align-items:center;gap:6px;padding:0 8px 0 10px;border-bottom:1px solid var(--line);background:var(--panel);font-size:10px;font-weight:600;color:var(--text)}
.mtp-head .seg{margin-left:auto}
.mtp-body{padding:4px;max-height:260px;overflow:auto}
.mtp-dir{width:100%;height:23px;display:flex;align-items:center;gap:5px;padding:0 6px;border:0;background:none;text-align:left;font:inherit;font-size:9.5px;color:var(--text2);cursor:default}
.mtp-dir:hover{background:var(--hover)}
.mtp-dir .cnt{margin-left:auto;font-size:8.5px;color:var(--text3)}
.mtp-file{width:100%;height:23px;display:flex;align-items:center;gap:6px;padding:0 6px;border:0;background:none;text-align:left;font:inherit;font-size:9.5px;color:var(--text2);border-radius:4px;cursor:default}
.mtp-file:hover{background:var(--hover)}
.mtp-file.on{background:var(--sel);color:var(--text)}
.mtp-file .dot{width:5px;height:5px;border-radius:50%;background:var(--danger);flex:none}
.mtp-file.resolved .dot{background:var(--ok)}
.mtp-file .cnt{margin-left:auto;font-size:8.5px;color:var(--text3)}

.commit{height:32px}
.commit .cg svg{height:32px;width:56px}

.commit{height:30px;padding-top:0;padding-bottom:0}
.commit .cg{height:30px}
.commit .cg svg{height:30px;width:52px}

.commit{height:28px;padding:0 8px 2px}
.commit .cg{height:26px}
.commit .cg svg{height:26px;width:50px}

/* ---------- P1: reflog, undo, blame, file history ---------- */
.reflog-row{width:100%;height:32px;flex:none;display:grid;grid-template-columns:62px minmax(0,1fr) 64px 44px;align-items:center;padding:0 8px;border:0;border-bottom:1px solid var(--line-soft);background:none;text-align:left;font:inherit;transition:background-color .12s ease;position:relative}
.reflog-row:hover{background:var(--hover)}
.reflog-row.on{background:var(--sel)}
.reflog-row.on::before{content:"";position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--accent)}
.reflog-hash{font-family:var(--mono);font-size:9px;color:var(--text3);white-space:nowrap}
.reflog-msg{min-width:0;font-size:11px;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-right:6px}
.reflog-op{display:inline-flex;align-items:center;justify-content:center;height:17px;padding:0 5px;border-radius:4px;background:var(--panel-2);font-size:8px;font-weight:600;letter-spacing:.02em;color:var(--text3);white-space:nowrap;justify-self:start}
.reflog-op.reset{background:color-mix(in srgb,var(--warn) 14%,var(--content));color:var(--warn)}
.reflog-op.commit{background:var(--accent-soft);color:var(--accent-2)}
.reflog-op.rebase{background:color-mix(in srgb,var(--purple) 12%,var(--content));color:var(--purple)}
.reflog-op.checkout{background:var(--panel-2);color:var(--text3)}
.reflog-date{font-size:9px;color:var(--text3);text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}

.undo-card{border:1px solid var(--line);border-radius:8px;background:var(--accent-soft);padding:11px;display:flex;flex-direction:column;gap:5px}
.undo-kicker{font-size:8px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--accent-2)}
.undo-title{font-family:var(--mono);font-size:10.5px;font-weight:600;color:var(--text);line-height:1.35}
.undo-copy{font-size:9.5px;color:var(--text2);line-height:1.5}
.undo-actions{display:flex;gap:6px;margin-top:4px}
.undo-actions .btn{height:24px;font-size:10px}
.undo-actions .btn.primary{flex:1;justify-content:center}
.undo-detail{display:flex;flex-direction:column;gap:3px;font-size:9.5px;color:var(--text3)}
.undo-detail b{color:var(--text2);font-weight:500}

.fhist-row{width:100%;height:32px;flex:none;display:grid;grid-template-columns:58px minmax(0,1fr) 70px 42px;align-items:center;padding:0 8px;border:0;border-bottom:1px solid var(--line-soft);background:none;text-align:left;font:inherit;transition:background-color .12s ease;position:relative}
.fhist-row:hover{background:var(--hover)}
.fhist-row.on{background:var(--sel)}
.fhist-row.on::before{content:"";position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--accent)}
.fhist-hash{font-family:var(--mono);font-size:9px;color:var(--text3);white-space:nowrap}
.fhist-msg{min-width:0;font-size:11px;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-right:6px}
.fhist-author{font-size:9.5px;color:var(--text3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-right:4px}
.fhist-date{font-size:9px;color:var(--text3);text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}

.blamepane{flex:1;min-height:0;display:flex;flex-direction:column;background:var(--content)}
.blamebar{height:34px;flex:none;display:flex;align-items:center;gap:7px;padding:0 10px;border-bottom:1px solid var(--line);background:var(--content);min-width:0}
.blamebar .fp{font-family:var(--mono);font-size:10.5px;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.blamebar .hash{flex:none}
.blamebar .spacer{flex:1}
.blamecode{flex:1;overflow:auto;padding:5px 0;font-family:var(--mono);font-size:10px;line-height:18px;min-height:0}
.blame-line{display:flex;align-items:stretch;min-height:18px;border-left:2px solid transparent}
.blame-line.on{background:var(--sel);border-left-color:var(--accent)}
.blame-gutter{width:126px;flex:none;display:flex;align-items:center;gap:5px;padding:0 8px;border-right:1px solid var(--line-soft);font-size:8.5px;color:var(--text3);white-space:nowrap;overflow:hidden;font-variant-numeric:tabular-nums}
.blame-gutter .bh{font-family:var(--mono);color:var(--text2)}
.blame-gutter .ba{color:var(--text3);overflow:hidden;text-overflow:ellipsis}
.blame-ln{width:32px;flex:none;text-align:right;padding-right:8px;color:var(--text3);font-size:9px;user-select:none;border-right:1px solid var(--line-soft)}
.blame-src{flex:1;padding:0 10px;white-space:pre;color:var(--text2)}
.blame-src .k{color:var(--purple)}
.blame-src .s{color:var(--ok)}
.blame-src .dim{color:var(--text3)}

.fhist-pane{width:330px;flex:none;border-right:1px solid var(--line);display:flex;flex-direction:column;min-height:0;background:var(--content)}
.fhist-bar{height:34px;flex:none;display:flex;align-items:center;gap:6px;padding:0 10px;border-bottom:1px solid var(--line);background:var(--content);min-width:0}
.fhist-bar .tt{font-size:11px;font-weight:600;color:var(--text)}
.fhist-bar .fp{font-family:var(--mono);font-size:9.5px;color:var(--text3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fhist-bar .spacer{flex:1}
.fhist-cols{height:22px;flex:none;display:grid;grid-template-columns:58px minmax(0,1fr) 70px 42px;align-items:center;padding:0 8px;border-bottom:1px solid var(--line-soft);font-size:8px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--text3)}
.fhist-cols .r{text-align:right}
.fhist-scroll{flex:1;overflow:auto;min-height:0}
